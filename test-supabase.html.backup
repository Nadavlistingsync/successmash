<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supabase Test</title>
</head>
<body>
    <h1>Supabase Connection Test</h1>
    <div id="status">Testing...</div>
    
    <!-- Load Supabase via CDN -->
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <script>
        console.log('🔄 Loading Supabase via CDN...');
        
        // Wait for CDN to load
        setTimeout(() => {
            try {
                if (window.supabase && window.supabase.createClient) {
                    console.log('✅ CDN loaded successfully');
                    window.__supabase = window.supabase.createClient(
                        "https://nubqazryyrougsyestiw.supabase.co",
                        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im51YnFhenJ5cnJvdWdzeWVzdGl3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU1NDczMzksImV4cCI6MjA3MTEyMzMzOX0.gGdt11cb6eRk7qvfbLK0tAYpxz3zZphQLhEYl3KkdIk"
                    );
                    console.log('✅ Supabase client created');
                    document.getElementById('status').textContent = 'CDN loaded, testing connection...';
                    
                    // Test connection
                    console.log('Testing database connection...');
                    window.__supabase
                        .from('users')
                        .select('*')
                        .limit(5)
                        .then(({ data: users, error }) => {
                            if (error) {
                                throw error;
                            }
                            
                            console.log('✅ Database connection successful!');
                            console.log('Users found:', users?.length || 0);
                            
                            document.getElementById('status').innerHTML = `
                                <div style="color: green; font-weight: bold;">
                                    ✅ Supabase Connected Successfully!<br>
                                    Users in database: ${users?.length || 0}
                                </div>
                            `;
                        })
                        .catch(error => {
                            console.error('❌ Database connection failed:', error);
                            document.getElementById('status').innerHTML = `
                                <div style="color: red; font-weight: bold;">
                                    ❌ Database Connection Failed<br>
                                    Error: ${error.message}
                                </div>
                            `;
                        });
                        
                } else {
                    throw new Error('Supabase CDN not loaded');
                }
            } catch (error) {
                console.error('❌ CDN loading failed:', error);
                document.getElementById('status').innerHTML = `
                    <div style="color: red; font-weight: bold;">
                        ❌ CDN Loading Failed<br>
                        Error: ${error.message}
                    </div>
                `;
            }
        }, 1000);
    </script>
</body>
</html>
