<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YN Young Network - Live Mode Activation</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            padding: 20px; 
            max-width: 600px; 
            margin: 0 auto; 
            background: linear-gradient(135deg, #1a365d, #2d5a87);
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .live-container {
            background: rgba(255, 255, 255, 0.1);
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        h1 { 
            font-size: 2.5rem; 
            margin-bottom: 20px; 
            color: #fbbf24;
        }
        .status {
            padding: 20px;
            margin: 20px 0;
            border-radius: 10px;
            font-weight: bold;
            font-size: 1.1rem;
        }
        .success { background: rgba(40, 167, 69, 0.3); border: 2px solid #28a745; }
        .error { background: rgba(220, 53, 69, 0.3); border: 2px solid #dc3545; }
        .warning { background: rgba(255, 193, 7, 0.3); border: 2px solid #ffc107; }
        .info { background: rgba(23, 162, 184, 0.3); border: 2px solid #17a2b8; }
        button { 
            padding: 15px 30px; 
            margin: 10px; 
            cursor: pointer; 
            border: none; 
            border-radius: 10px; 
            background: #fbbf24; 
            color: #1a365d; 
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }
        button:hover { 
            background: #f59e0b; 
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .live-indicator {
            font-size: 3rem;
            margin: 20px 0;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }
        .instructions {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: left;
        }
        .instructions h3 {
            color: #fbbf24;
            margin-top: 0;
        }
        .instructions ol {
            margin: 10px 0;
            padding-left: 20px;
        }
        .instructions li {
            margin: 8px 0;
        }
    </style>
</head>
<body>
    <div class="live-container">
        <h1>🚀 LIVE MODE ACTIVATION</h1>
        
        <div class="live-indicator" id="live-indicator">🔴</div>
        
        <div id="status" class="status info">
            Ready to activate live mode...
        </div>
        
        <button onclick="activateLiveMode()">🚀 ACTIVATE LIVE MODE</button>
        <button onclick="checkStatus()">🔍 CHECK STATUS</button>
        <button onclick="goToMain()">🎮 GO TO MAIN GAME</button>
        
        <div class="instructions">
            <h3>How to make your site 100% live:</h3>
            <ol>
                <li><strong>Click "ACTIVATE LIVE MODE"</strong> - This will force enable real-time</li>
                <li><strong>Enable Real-Time in Supabase</strong> (if not already done):
                    <ul>
                        <li>Go to <a href="https://supabase.com/dashboard" target="_blank" style="color: #fbbf24;">Supabase Dashboard</a></li>
                        <li>Select your project (nubqazryyrougsyestiw)</li>
                        <li>Go to Database → Replication</li>
                        <li>Enable real-time for: users, votes, statistics</li>
                    </ul>
                </li>
                <li><strong>Test with multiple devices</strong> - Vote on one, watch updates on another!</li>
            </ol>
        </div>
    </div>
    
    <script>
        function updateStatus(message, type = 'info') {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = message;
            statusDiv.className = `status ${type}`;
        }
        
        function updateLiveIndicator(isLive) {
            const indicator = document.getElementById('live-indicator');
            if (isLive) {
                indicator.textContent = '🟢';
                indicator.style.animation = 'none';
            } else {
                indicator.textContent = '🔴';
                indicator.style.animation = 'pulse 2s infinite';
            }
        }
        
        async function activateLiveMode() {
            updateStatus('🚀 Activating live mode...', 'warning');
            
            // Wait for main app to load
            let attempts = 0;
            const maxAttempts = 10;
            
            const checkApp = setInterval(() => {
                attempts++;
                
                if (typeof window.youngNetwork !== 'undefined') {
                    clearInterval(checkApp);
                    
                    // Force enable live mode
                    if (typeof window.forceLiveMode === 'function') {
                        window.forceLiveMode();
                        updateStatus('✅ Live mode activated! Checking connection...', 'success');
                        
                        // Check status after 3 seconds
                        setTimeout(() => {
                            checkStatus();
                        }, 3000);
                    } else {
                        updateStatus('❌ Live mode function not available', 'error');
                    }
                } else if (attempts >= maxAttempts) {
                    clearInterval(checkApp);
                    updateStatus('❌ Main app not loaded. Please go to main page first.', 'error');
                } else {
                    updateStatus(`⏳ Loading main app... (${attempts}/${maxAttempts})`, 'info');
                }
            }, 1000);
        }
        
        function checkStatus() {
            if (typeof window.getLiveStatus === 'function') {
                const status = window.getLiveStatus();
                
                if (status.realTimeActive) {
                    updateStatus('🟢 LIVE MODE ACTIVE! Real-time updates are working!', 'success');
                    updateLiveIndicator(true);
                } else if (status.supabaseEnabled) {
                    updateStatus('⚠️ Supabase connected but real-time not active. Enable real-time in Supabase dashboard.', 'warning');
                    updateLiveIndicator(false);
                } else {
                    updateStatus('❌ Supabase not connected. Please activate live mode first.', 'error');
                    updateLiveIndicator(false);
                }
            } else {
                updateStatus('❌ Status check not available. Please go to main page first.', 'error');
            }
        }
        
        function goToMain() {
            window.location.href = '/';
        }
        
        // Auto-check status on load
        setTimeout(() => {
            checkStatus();
        }, 2000);
    </script>
</body>
</html>
